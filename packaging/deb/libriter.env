# Konfigurace Libriteru nainstalovaného z .deb balíčku. Úpravy upgrade
# balíčku nepřepíše; po změně: sudo systemctl restart libriter
# Popis všech proměnných: libriter-backend/env.example v repozitáři.

# Server
SERVER_PORT=8080
SERVER_ENV=production

# Databáze (SQLite – soubor i schéma se vytvoří automaticky při startu)
DB_PATH=/var/lib/libriter/libriter.db

# JWT – tajemství vygeneruje instalace balíčku (postinst)
JWT_SECRET=
JWT_EXPIRY_HOURS=72
JWT_MOBILE_EXPIRY_DAYS=365

# Soubory
AUDIO_ROOT=/var/lib/libriter/books
COVER_ROOT=/var/lib/libriter/covers
AUTHOR_IMAGE_ROOT=/var/lib/libriter/author-images
IMPORT_ROOT=/var/lib/libriter/import
MAX_UPLOAD_MB=3072

# Výchozí jazyk nových knih (ISO 639-1)
DEFAULT_BOOK_LANGUAGE=cs

# Zdroje metadat – výchozí hodnoty pro čerstvou databázi; po uložení
# v administraci vyhrává databáze.
METADATA_PROVIDERS=databazeknih,cbdb,openlibrary,googlebooks
METADATA_LANGUAGE_PROVIDERS=cs=databazeknih,cbdb,openlibrary,googlebooks;en=audible_com,goodreads,openlibrary,googlebooks;de=audible_de,googlebooks,openlibrary

# Google Books – nepovinné
GOOGLE_BOOKS_API_KEY=
