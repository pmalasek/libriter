#!/bin/sh
set -e

ENV_FILE=/etc/libriter/libriter.env
DATA_DIR=/var/lib/libriter

if [ "$1" = "configure" ]; then
    if ! getent passwd libriter >/dev/null; then
        adduser --system --group --home "$DATA_DIR" --no-create-home \
            --gecos "Libriter" libriter
    fi

    for dir in "$DATA_DIR" "$DATA_DIR/books" "$DATA_DIR/covers" \
               "$DATA_DIR/author-images" "$DATA_DIR/import"; do
        mkdir -p "$dir"
        chown libriter:libriter "$dir"
    done
    chmod 750 "$DATA_DIR"

    # Tajemství JWT jen při prázdné hodnotě – upgrade ho nemění.
    if grep -q '^JWT_SECRET=$' "$ENV_FILE"; then
        secret=$(openssl rand -hex 32)
        sed -i "s/^JWT_SECRET=\$/JWT_SECRET=$secret/" "$ENV_FILE"
    fi
    chown root:libriter "$ENV_FILE"
    chmod 640 "$ENV_FILE"

    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        systemctl enable libriter.service >/dev/null
        systemctl restart libriter.service
    fi
fi

exit 0
