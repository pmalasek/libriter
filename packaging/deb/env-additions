# ---- Weby produktů (doplněno ve verzi 2.0) ----
# Host rozhoduje, které webové rozhraní prohlížeč dostane; API na hostu
# nezávisí. Ostatní hosty (IP adresa, localhost) dostanou DEFAULT_PRODUCT.
LIBRITER_HOST=
SCENITER_HOST=
DEFAULT_PRODUCT=libriter

# ---- Sceniter – filmy a seriály (doplněno ve verzi 2.0) ----
# Prázdné VIDEO_ROOT = Sceniter je vypnutý. Adresář stačí číst; nesmí ležet
# pod /home (služba má ProtectHome=true).
# Které podsložky jsou filmy a které seriály, nastavuje admin v administraci
# Sceniteru (Knihovny).
VIDEO_ROOT=
SCENITER_IMAGE_ROOT=/var/lib/libriter/sceniter-images
SCENITER_RESCAN_MINUTES=0
# Výchozí klíč pluginu TMDB; klíč uložený v administraci (Zdroje metadat) má přednost.
TMDB_API_KEY=
TRANSCODE_ROOT=/var/cache/libriter/transcode
TRANSCODE_MAX_SESSIONS=2
TRANSCODE_IDLE_SECONDS=60
TRANSCODE_MAX_HEIGHT=1080

# ---- Pluginy metadat (doplněno ve verzi 2.1) ----
# Adresář se zdroji metadat (mediater-meta-*). Soubory musí patřit rootovi
# a nesmí být zapisovatelné pro skupinu ani ostatní.
PLUGIN_DIR=/usr/lib/mediater/plugins

# ---- Zabezpečení (doplněno s limity přihlášení) ----
# Reverzní proxy, kterým server věří X-Real-IP / X-Forwarded-For (IP nebo
# CIDR, čárkou oddělené). Podle IP klienta se počítají limity přihlášení,
# registrace a párování TV. Výchozí hodnota stačí pro nginx na tomtéž stroji;
# běží-li jinde, doplňte jeho adresu, jinak všichni klienti sdílejí jeden limit.
# Dále platí: JWT_SECRET musí mít v produkci aspoň 32 bajtů (instalace ho
# generuje sama) a veřejná registrace je na nové instanci vypnutá – zapíná se
# v administraci (Registrace).
TRUSTED_PROXIES=127.0.0.0/8,::1

# ---- Import knih (doplněno s limitem importů) ----
# Kolik importů smí být rozpracovaných najednou; každý zabere až MAX_UPLOAD_MB.
IMPORT_MAX_SESSIONS=5
