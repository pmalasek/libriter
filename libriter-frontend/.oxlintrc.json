{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/auth/AuthContext.tsx",
        "src/auth/RequireAuth.tsx",
        "src/auth/RequireRole.tsx",
        "src/auth/permissions.ts",
        "src/auth/session.ts",
        "src/auth/useRefreshProfile.ts",
        "src/components/EmptyState.tsx",
        "src/components/ErrorState.tsx",
        "src/components/PageHeader.tsx",
        "src/components/layout/AppearanceSettings.tsx",
        "src/components/layout/AuroraBackdrop.tsx",
        "src/components/layout/AuthShell.tsx",
        "src/components/layout/LanguageToggle.tsx",
        "src/components/layout/ThemeToggle.tsx",
        "src/components/layout/UiLanguageSelect.tsx",
        "src/components/layout/UserMenu.tsx",
        "src/components/ui/alert-dialog.tsx",
        "src/components/ui/avatar.tsx",
        "src/components/ui/badge.tsx",
        "src/components/ui/button.tsx",
        "src/components/ui/card.tsx",
        "src/components/ui/collapsible.tsx",
        "src/components/ui/dialog.tsx",
        "src/components/ui/dropdown-menu.tsx",
        "src/components/ui/input.tsx",
        "src/components/ui/label.tsx",
        "src/components/ui/popover.tsx",
        "src/components/ui/select.tsx",
        "src/components/ui/separator.tsx",
        "src/components/ui/sheet.tsx",
        "src/components/ui/skeleton.tsx",
        "src/components/ui/slider.tsx",
        "src/components/ui/sonner.tsx",
        "src/components/ui/switch.tsx",
        "src/components/ui/table.tsx",
        "src/components/ui/textarea.tsx",
        "src/i18n/LanguageProvider.tsx",
        "src/i18n/language.ts",
        "src/lib/utils.ts",
        "src/pages/LoginPage.tsx",
        "src/pages/ProfilePage.tsx",
        "src/pages/RegisterPage.tsx",
        "src/theme/ColorSchemeProvider.tsx",
        "src/theme/ThemeProvider.tsx",
        "src/theme/colorScheme.ts"
      ],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ]
}
