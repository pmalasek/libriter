# Server
SERVER_PORT=8080
SERVER_ENV=development          # development | production

# Databáze (SQLite – soubor i schéma se vytvoří automaticky při startu)
DB_PATH=./data/libriter.db

# JWT – NUTNÉ ZMĚNIT před nasazením do produkce!
JWT_SECRET=change-me-before-production
JWT_EXPIRY_HOURS=72

# Platnost tokenu mobilní aplikace ve dnech. Mobil se přihlašuje jednou a pak
# jede i offline; token vydává POST /api/v1/auth/mobile-token a otevírá jen
# API, ne audio soubory (ty mají vlastní krátkodobý token v adrese).
JWT_MOBILE_EXPIRY_DAYS=365

# Soubory
AUDIO_ROOT=./data/books         # kořenový adresář audio souborů
COVER_ROOT=./data/covers        # kořenový adresář obálek knih
AUTHOR_IMAGE_ROOT=./data/author-images   # fotky autorů (stahují se ze zdrojů metadat; výchozí = vedle COVER_ROOT)
IMPORT_ROOT=./data/import       # staging importu knih (mimo AUDIO_ROOT; výchozí = vedle AUDIO_ROOT)
MAX_UPLOAD_MB=3072              # limit jednoho importu knih v MB (součet souborů)

# Výchozí jazyk nových knih (ISO 639-1), když ho neuvádějí audio tagy ani
# ten, kdo knihu zakládá. Jen výchozí hodnota – po uložení v administraci
# vyhrává databáze.
DEFAULT_BOOK_LANGUAGE=cs

# Zdroje metadat – pořadí, ve kterém se zkoušejí (první, kdo něco najde, vyhrává).
# Zdroj, který v seznamu není, je vypnutý; prázdná hodnota vypne metadata úplně.
# Možnosti: databazeknih | cbdb | openlibrary | googlebooks | audible_com | audible_de | goodreads
#
# Pozor: tohle je jen výchozí hodnota pro čerstvou databázi. Jakmile admin
# nastaví zdroje ve webové administraci, platí uložené nastavení a změny tady
# se už neprojeví.
METADATA_PROVIDERS=databazeknih,cbdb,openlibrary,googlebooks

# Vlastní pořadí zdrojů pro jazyky knih (kód ISO 639-1). Hledání metadat
# použije profil podle jazyka knihy; jazyk, který tu není, jede na
# METADATA_PROVIDERS. Prázdná hodnota = žádné jazykové profily.
# Další zdroje: audible_com | audible_de | goodreads
# Stejně jako výš: po uložení v administraci vyhrává databáze.
METADATA_LANGUAGE_PROVIDERS=cs=databazeknih,cbdb,openlibrary,googlebooks;en=audible_com,goodreads,openlibrary,googlebooks;de=audible_de,googlebooks,openlibrary

# Google Books – nepovinné. Bez klíče se jede na anonymní denní kvótu sdílenou
# pro celou IP adresu, která se snadno vyčerpá (HTTP 429).
# Klíč: https://console.cloud.google.com/apis/credentials (zapnout Books API)
# Stejně jako u zdrojů výš: po uložení v administraci vyhrává databáze.
GOOGLE_BOOKS_API_KEY=
