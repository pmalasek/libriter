{
  "compilerOptions": {
    "target": "es2023",
    // DOM je tu kvůli typům `fetch`, `Headers`, `Response` a `atob` – ty má
    // prohlížeč i React Native. Není to svolení sáhnout na `document`:
    // balíček musí zůstat použitelný v obou prostředích.
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
